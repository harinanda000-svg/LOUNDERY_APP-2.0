{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "**"
    },
    "api/*.js": {
      "includeFiles": "**"
    }
  },
  "routes": [
    {
      "src": "/api/login",
      "dest": "/api/login.js"
    },
    {
      "src": "/login",
      "methods": ["POST"],
      "dest": "/api/login.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
